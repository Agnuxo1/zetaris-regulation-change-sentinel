# Zetaris connection (local Docker install defaults). Never commit a filled-in copy.
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
# Either a GUI-created bearer key...
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# ...or the local administrator login used by the install.
ZETARIS_LOGIN_URL=http://127.0.0.1:3000/api/auth/login
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Control pipeline (bench/): direct connections, no Zetaris
CONTROL_PG_DSN=host=regsentinel-pg dbname=grants user=sentinel_reader
CONTROL_CSV=data/processed/paragraphs.csv
